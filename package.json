{
  "name": "lunatrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev:all": "python3 scripts/dev.py",
    "setup": "sh scripts/setup.sh",
    "prepare:terrain": "PYTHONPATH=backend backend/.venv/bin/python -m app.cli prepare",
    "test:backend": "PYTHONPATH=backend backend/.venv/bin/python -m pytest backend/tests -q",
    "benchmark": "PYTHONPATH=backend backend/.venv/bin/python -m app.cli benchmark",
    "typecheck": "tsc --noEmit",
    "verify:lifecycle": "python3 scripts/verify_lifecycle.py"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
